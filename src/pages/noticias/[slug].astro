---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('noticias');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = await getCollection('noticias');
const related = allArticles
  .filter(a => a.id !== article.id && (a.data.category === article.data.category || a.data.colonia === article.data.colonia))
  .slice(0, 3);

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('es-MX', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(d);
}
---

<BaseLayout
  title={article.data.title}
  description={article.data.excerpt || article.data.subtitle}
  image={article.data.image}
  type="article"
  pubDate={article.data.pubDate}
  author={article.data.author}
  activeSection={article.data.category}
>
  <div class="container" style="max-width: 860px; margin: 0 auto; padding: 0 16px;">
    
    <!-- Breadcrumb -->
    <nav style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-muted); margin-bottom: 20px;">
      <a href="/" style="color: var(--color-text-muted); text-decoration: none;">Inicio</a>
      <span>/</span>
      <span style="color: var(--color-primary); font-weight: 600;">{article.data.category}</span>
      {article.data.colonia && (
        <>
          <span>/</span>
          <span>{article.data.colonia}</span>
        </>
      )}
    </nav>

    <article class="g-card" style="padding: 32px; background: #ffffff;">
      
      <!-- Meta Badges -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; font-size: 12px;">
        <span style="background: var(--color-primary); color: #ffffff; padding: 3px 10px; border-radius: 6px; font-weight: 700; text-transform: uppercase;">
          {article.data.category}
        </span>
        {article.data.colonia && (
          <span style="background: #f1f3f4; color: var(--color-text-main); padding: 3px 10px; border-radius: 6px; font-weight: 600;">
            📍 {article.data.colonia}
          </span>
        )}
        <span style="color: var(--color-text-muted);">
          Publicado el {formatDate(article.data.pubDate)}
        </span>
      </div>

      <!-- Headline -->
      <h1 style="font-size: 32px; font-weight: 800; line-height: 1.25; color: var(--color-text-main); letter-spacing: -0.5px; margin-bottom: 14px;">
        {article.data.title}
      </h1>

      <!-- Subtitle -->
      {article.data.subtitle && (
        <p style="font-size: 18px; color: var(--color-text-muted); line-height: 1.5; font-weight: 500; margin-bottom: 24px; border-left: 3px solid var(--color-primary); padding-left: 14px;">
          {article.data.subtitle}
        </p>
      )}

      <!-- Author Bar -->
      <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border-light); border-bottom: 1px solid var(--color-border-light); padding: 12px 0; margin-bottom: 24px; font-size: 13px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <img src="/icon.png" alt="Icono" style="width: 28px; height: 28px; border-radius: 50%;" onerror="this.style.display='none';" />
          <div>
            <div style="font-weight: 700; color: var(--color-text-main);">{article.data.author}</div>
            <div style="font-size: 11px; color: var(--color-text-subtle);">Gustavo A. Madero, CDMX</div>
          </div>
        </div>
        <div style="color: var(--color-text-muted); font-size: 12px;">
          ⏱️ 3 min de lectura
        </div>
      </div>

      <!-- Main Featured Image -->
      <figure style="margin-bottom: 28px;">
        <img 
          src={article.data.image} 
          alt={article.data.title}
          referrerpolicy="no-referrer"
          onerror="this.onerror=null; this.src='/logo.png';"
          style="width: 100%; max-height: 440px; object-fit: cover; border-radius: 12px; border: 1px solid var(--color-border);" 
        />
        {article.data.imageCaption && (
          <figcaption style="font-size: 12px; color: var(--color-text-subtle); margin-top: 8px; text-align: center; font-style: italic;">
            {article.data.imageCaption}
          </figcaption>
        )}
      </figure>

      <!-- Markdown Body -->
      <div class="article-body">
        <Content />
      </div>

      <!-- Tags & Share -->
      {article.data.tags && article.data.tags.length > 0 && (
        <div style="margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--color-border-light);">
          <div style="font-size: 12px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; margin-bottom: 10px;">Temas relacionados:</div>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {article.data.tags.map(tag => (
              <span style="background: #f1f3f4; color: var(--color-text-main); font-size: 12px; padding: 4px 10px; border-radius: var(--radius-pill); font-weight: 500;">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

    </article>

    <!-- Related Articles -->
    {related.length > 0 && (
      <section style="margin-top: 40px;">
        <h3 style="font-size: 18px; font-weight: 800; color: var(--color-text-main); margin-bottom: 16px;">
          Más reportes en tu colonia
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
          {related.map(r => (
            <a href={`/noticias/${r.id}/`} class="g-card" style="padding: 16px; text-decoration: none; color: inherit; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); margin-bottom: 6px; display: block;">{r.data.category}</span>
                <h4 style="font-size: 14px; font-weight: 700; line-height: 1.35; margin-bottom: 8px; color: var(--color-text-main);">{r.data.title}</h4>
              </div>
              <span style="font-size: 12px; color: var(--color-text-subtle);">{formatDate(r.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>

  <style is:global>
    .article-body {
      font-size: 16px;
      line-height: 1.75;
      color: #202124;
    }

    .article-body p {
      margin-bottom: 20px;
    }

    .article-body h2 {
      font-size: 22px;
      font-weight: 800;
      color: #202124;
      margin: 32px 0 14px 0;
      letter-spacing: -0.3px;
    }

    .article-body h3 {
      font-size: 18px;
      font-weight: 700;
      color: #202124;
      margin: 24px 0 12px 0;
    }

    .article-body ul, .article-body ol {
      margin: 16px 0 24px 24px;
    }

    .article-body li {
      margin-bottom: 8px;
    }

    .article-body blockquote {
      border-left: 4px solid var(--color-primary);
      padding: 12px 20px;
      margin: 24px 0;
      background: #faf8f8;
      border-radius: 0 8px 8px 0;
      font-style: italic;
      color: #444746;
    }

    .article-body strong {
      color: #000000;
    }
  </style>

</BaseLayout>
