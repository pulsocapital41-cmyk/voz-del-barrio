---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNoticias = await getCollection('noticias');
const noticiasSorted = allNoticias.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredArticle = noticiasSorted.find(n => n.data.featured) || noticiasSorted[0];
const remainingArticles = noticiasSorted.filter(n => n.id !== featuredArticle.id);

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(d);
}
---

<BaseLayout title="La Voz del Barrio GAM — Noticias y Comunidad" activeSection="Inicio">
  <div class="container">
    
    <!-- Hero / Featured Story -->
    {featuredArticle && (
      <article class="clean-card" style="margin-bottom: 48px; display: grid; grid-template-columns: 1fr; background: #ffffff;">
        <a href={`/noticias/${featuredArticle.id}/`} style="display: block; overflow: hidden;">
          <img 
            src={featuredArticle.data.image} 
            alt={featuredArticle.data.title}
            referrerpolicy="no-referrer"
            onerror="this.onerror=null; this.src='/logo.png';"
            style="width: 100%; height: 380px; object-fit: cover;" 
          />
        </a>

        <div style="padding: 32px 36px;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px; font-size: 13px;">
            <span style="background: var(--color-primary-light); color: var(--color-primary); padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 12px;">
              {featuredArticle.data.category}
            </span>
            {featuredArticle.data.colonia && (
              <span style="color: var(--color-text-muted); font-weight: 500;">
                📍 {featuredArticle.data.colonia}
              </span>
            )}
            <span style="color: var(--color-border);">•</span>
            <span style="color: var(--color-text-subtle);">{formatDate(featuredArticle.data.pubDate)}</span>
          </div>

          <h2 style="font-size: 28px; font-weight: 800; line-height: 1.3; color: var(--color-text-main); margin-bottom: 14px; letter-spacing: -0.4px;">
            <a href={`/noticias/${featuredArticle.id}/`} style="color: inherit; text-decoration: none;" class="title-link">
              {featuredArticle.data.title}
            </a>
          </h2>

          <p style="font-size: 16px; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 20px;">
            {featuredArticle.data.excerpt || featuredArticle.data.subtitle}
          </p>

          <div style="display: flex; align-items: center; justify-content: space-between; font-size: 13px;">
            <span style="color: var(--color-text-subtle);">{featuredArticle.data.author}</span>
            <a href={`/noticias/${featuredArticle.id}/`} style="color: var(--color-primary); font-weight: 700; text-decoration: none;">
              Leer historia →
            </a>
          </div>
        </div>
      </article>
    )}

    <!-- Clean Grid of Stories -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 28px;">
      {remainingArticles.map(art => (
        <article class="clean-card" style="display: flex; flex-direction: column; justify-content: space-between; background: #ffffff;">
          <div>
            <a href={`/noticias/${art.id}/`} style="display: block; overflow: hidden;">
              <img 
                src={art.data.image} 
                alt={art.data.title}
                referrerpolicy="no-referrer"
                onerror="this.onerror=null; this.src='/logo.png';"
                style="width: 100%; height: 200px; object-fit: cover;" 
              />
            </a>

            <div style="padding: 22px;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: 12px;">
                <span style="color: var(--color-primary); font-weight: 700;">
                  {art.data.category}
                </span>
                {art.data.colonia && (
                  <span style="color: var(--color-text-subtle);">
                    {art.data.colonia}
                  </span>
                )}
              </div>

              <h3 style="font-size: 18px; font-weight: 700; line-height: 1.35; color: var(--color-text-main); margin-bottom: 10px;">
                <a href={`/noticias/${art.id}/`} style="color: inherit; text-decoration: none;" class="title-link">
                  {art.data.title}
                </a>
              </h3>

              <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {art.data.excerpt || art.data.subtitle}
              </p>
            </div>
          </div>

          <div style="padding: 0 22px 20px 22px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--color-text-subtle); border-top: 1px solid var(--color-border); padding-top: 12px;">
            <span>{formatDate(art.data.pubDate)}</span>
            <a href={`/noticias/${art.id}/`} style="color: var(--color-primary); font-weight: 600;">
              Leer más →
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <style>
    .title-link:hover {
      color: var(--color-primary);
    }

    @media (min-width: 860px) {
      .clean-card article {
        grid-template-columns: 1.2fr 1fr;
      }
    }
  </style>
</BaseLayout>
