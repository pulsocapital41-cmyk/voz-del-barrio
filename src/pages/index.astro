---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNoticias = await getCollection('noticias');
const noticiasSorted = allNoticias.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredArticle = noticiasSorted.find(n => n.data.featured) || noticiasSorted[0];
const subFeatured = noticiasSorted.filter(n => n.id !== featuredArticle.id).slice(0, 2);
const remainingArticles = noticiasSorted.filter(n => n.id !== featuredArticle.id && !subFeatured.some(s => s.id === n.id));

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(d);
}
---

<BaseLayout title="La Voz del Barrio GAM — Noticias, Comunidad y Denuncia Ciudadana" activeSection="Portada">
  
  <div class="container">
    
    <!-- Breaking Alert / Google News Top Ticker -->
    {featuredArticle.data.breaking && (
      <div style="background: #ffffff; border: 1px solid var(--color-border); border-left: 4px solid var(--color-urgent); border-radius: 8px; padding: 10px 16px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 13px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="background: var(--color-urgent); color: #ffffff; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 4px; text-transform: uppercase;">Última Hora</span>
          <a href={`/noticias/${featuredArticle.id}/`} style="font-weight: 600; color: var(--color-text-main); text-decoration: none;">
            {featuredArticle.data.title}
          </a>
        </div>
        <span style="color: var(--color-text-muted); font-size: 12px; white-space: nowrap;">Hace unos momentos</span>
      </div>
    )}

    <!-- Main 2-Column Grid (Google News Style) -->
    <div style="display: grid; grid-template-columns: 1fr; gap: 24px;" class="layout-grid">
      
      <!-- Left / Center Column: Stories Feed -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- SECTION 1: Google News Top Stories Grouped Card -->
        <section class="g-card" style="padding: 24px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; border-bottom: 1px solid var(--color-border-light); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 18px;">📰</span>
              <h2 style="font-size: 18px; font-weight: 800; color: var(--color-text-main); letter-spacing: -0.3px;">Noticias destacadas</h2>
            </div>
            <span style="font-size: 12px; color: var(--color-text-muted);">Gustavo A. Madero</span>
          </div>

          <!-- Hero Main Story -->
          {featuredArticle && (
            <div style="display: grid; grid-template-columns: 1fr; gap: 20px; margin-bottom: 24px;" class="hero-grid">
              <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 12px;">
                  <span style="font-weight: 700; color: var(--color-primary);">{featuredArticle.data.category}</span>
                  {featuredArticle.data.colonia && (
                    <>
                      <span style="color: var(--color-border); font-size: 10px;">•</span>
                      <span style="background: #f1f3f4; color: var(--color-text-muted); padding: 2px 8px; border-radius: 12px; font-weight: 500;">{featuredArticle.data.colonia}</span>
                    </>
                  )}
                  <span style="color: var(--color-border); font-size: 10px;">•</span>
                  <span style="color: var(--color-text-muted);">{formatDate(featuredArticle.data.pubDate)}</span>
                </div>

                <h3 style="font-size: 22px; font-weight: 800; line-height: 1.3; color: var(--color-text-main); margin-bottom: 12px;">
                  <a href={`/noticias/${featuredArticle.id}/`} style="color: inherit; text-decoration: none;" class="hover-title">
                    {featuredArticle.data.title}
                  </a>
                </h3>

                <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 16px;">
                  {featuredArticle.data.excerpt || featuredArticle.data.subtitle}
                </p>

                <div style="display: flex; align-items: center; justify-content: space-between;">
                  <span style="font-size: 12px; color: var(--color-text-subtle);">{featuredArticle.data.author}</span>
                  <a href={`/noticias/${featuredArticle.id}/`} style="font-size: 13px; font-weight: 700; color: var(--color-primary); text-decoration: none;">
                    Leer historia completa →
                  </a>
                </div>
              </div>

              <div>
                <a href={`/noticias/${featuredArticle.id}/`}>
                  <img 
                    src={featuredArticle.data.image} 
                    alt={featuredArticle.data.title} 
                    referrerpolicy="no-referrer"
                    onerror="this.onerror=null; this.src='/logo.png';"
                    style="width: 100%; height: 260px; object-fit: cover; border-radius: 12px; border: 1px solid var(--color-border);" 
                  />
                </a>
              </div>
            </div>
          )}

          <!-- Sub-Stories (Google News 2-Item Row) -->
          {subFeatured.length > 0 && (
            <div style="border-top: 1px solid var(--color-border-light); padding-top: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
              {subFeatured.map(item => (
                <article style="display: flex; justify-content: space-between; gap: 14px;">
                  <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 6px; font-size: 11px; margin-bottom: 6px;">
                      <span style="font-weight: 700; color: var(--color-primary);">{item.data.category}</span>
                      {item.data.colonia && (
                        <span style="color: var(--color-text-muted);">· {item.data.colonia}</span>
                      )}
                    </div>
                    <h4 style="font-size: 15px; font-weight: 700; line-height: 1.35; color: var(--color-text-main); margin-bottom: 6px;">
                      <a href={`/noticias/${item.id}/`} class="hover-title">
                        {item.data.title}
                      </a>
                    </h4>
                    <span style="font-size: 12px; color: var(--color-text-subtle);">{formatDate(item.data.pubDate)}</span>
                  </div>
                  <a href={`/noticias/${item.id}/`} style="flex-shrink: 0;">
                    <img 
                      src={item.data.image} 
                      alt={item.data.title}
                      referrerpolicy="no-referrer"
                      onerror="this.onerror=null; this.src='/logo.png';"
                      style="width: 84px; height: 84px; object-fit: cover; border-radius: 8px; border: 1px solid var(--color-border);" 
                    />
                  </a>
                </article>
              ))}
            </div>
          )}
        </section>

        <!-- SECTION 2: Hyperlocal Stories Feed -->
        <section>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 18px;">📍</span>
              <h2 style="font-size: 18px; font-weight: 800; color: var(--color-text-main); letter-spacing: -0.3px;">Reportes de la Comunidad</h2>
            </div>
            <span style="font-size: 12px; color: var(--color-text-muted);">Vigilancia barrial y servicios</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
            {remainingArticles.map(art => (
              <article class="g-card" style="padding: 18px; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
                <div>
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: 12px;">
                    <span style="background: var(--color-primary-light); color: var(--color-primary); padding: 2px 8px; border-radius: 6px; font-weight: 700; font-size: 11px;">
                      {art.data.category}
                    </span>
                    {art.data.colonia && (
                      <span style="color: var(--color-text-muted); font-weight: 500;">
                        📍 {art.data.colonia}
                      </span>
                    )}
                  </div>

                  <a href={`/noticias/${art.id}/`} style="display: block; margin-bottom: 12px;">
                    <img 
                      src={art.data.image} 
                      alt={art.data.title}
                      referrerpolicy="no-referrer"
                      onerror="this.onerror=null; this.src='/logo.png';"
                      style="width: 100%; height: 160px; object-fit: cover; border-radius: 8px; border: 1px solid var(--color-border-light);" 
                    />
                  </a>

                  <h3 style="font-size: 16px; font-weight: 700; line-height: 1.35; color: var(--color-text-main); margin-bottom: 8px;">
                    <a href={`/noticias/${art.id}/`} class="hover-title">
                      {art.data.title}
                    </a>
                  </h3>

                  <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    {art.data.excerpt || art.data.subtitle}
                  </p>
                </div>

                <div style="border-top: 1px solid var(--color-border-light); padding-top: 10px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--color-text-subtle);">
                  <span>{formatDate(art.data.pubDate)}</span>
                  <a href={`/noticias/${art.id}/`} style="color: var(--color-primary); font-weight: 600;">Leer más →</a>
                </div>
              </article>
            ))}
          </div>
        </section>

      </div>

      <!-- Right Column: Google News Sidebar (Local Widgets) -->
      <aside style="display: flex; flex-direction: column; gap: 20px;">
        
        <!-- Widget 1: Clima y Entorno GAM -->
        <div class="g-card" style="padding: 20px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-main);">Clima & Movilidad GAM</h3>
            <span style="font-size: 11px; background: #e6f4ea; color: #137333; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Aire: Aceptable</span>
          </div>

          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
            <div style="font-size: 38px;">⛅</div>
            <div>
              <div style="font-size: 26px; font-weight: 800; color: var(--color-text-main); line-height: 1;">21°C</div>
              <div style="font-size: 12px; color: var(--color-text-muted);">Gustavo A. Madero · Parcialmente nublado</div>
            </div>
          </div>

          <div style="background: #f8f9fa; border-radius: 8px; padding: 10px 12px; font-size: 12px; line-height: 1.5; color: var(--color-text-main);">
            <div style="font-weight: 700; margin-bottom: 2px;">🚗 Hoy No Circula (CDMX):</div>
            <div style="color: var(--color-text-muted);">Engomado <strong>Rojo</strong> · Terminación placas <strong>3 y 4</strong> · Hologramas 1 y 2.</div>
          </div>
        </div>

        <!-- Widget 2: Buzón Ciudadano GAM -->
        <div class="g-card" style="padding: 20px; border-left: 4px solid var(--color-primary);">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
            <span style="font-size: 18px;">📣</span>
            <h3 style="font-size: 14px; font-weight: 800; color: var(--color-text-main); text-transform: uppercase; letter-spacing: 0.5px;">Buzón del Vecino</h3>
          </div>
          <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 14px;">
            ¿Tienes una fuga de agua, socavón, falta de luminarias o bache en tu colonia? Envíanos tu reporte con foto y ubicación exacta.
          </p>
          <a 
            href="mailto:redaccion@vozdelbarrio.com.mx?subject=Denuncia%20Ciudadana%20GAM"
            style="display: block; text-align: center; background: var(--color-primary); color: #ffffff; padding: 9px 16px; border-radius: var(--radius-pill); font-size: 13px; font-weight: 700; text-decoration: none;"
          >
            Enviar reporte ciudadano
          </a>
        </div>

        <!-- Widget 3: Tendencias en la GAM (Top 5) -->
        <div class="g-card" style="padding: 20px;">
          <h3 style="font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-main); margin-bottom: 16px; border-bottom: 1px solid var(--color-border-light); padding-bottom: 10px;">
            Más leídas en la alcaldía
          </h3>

          <ol style="list-style: none; display: flex; flex-direction: column; gap: 14px; counter-reset: ranking;">
            {noticiasSorted.slice(0, 5).map((n, idx) => (
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="font-size: 18px; font-weight: 800; color: var(--color-primary); min-width: 20px; line-height: 1.2;">
                  {idx + 1}
                </span>
                <div>
                  <h4 style="font-size: 13px; font-weight: 700; line-height: 1.35; margin-bottom: 4px;">
                    <a href={`/noticias/${n.id}/`} class="hover-title" style="color: var(--color-text-main);">
                      {n.data.title}
                    </a>
                  </h4>
                  <div style="font-size: 11px; color: var(--color-text-subtle);">
                    {n.data.colonia || n.data.category} · {formatDate(n.data.pubDate)}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- Widget 4: Puntos de Interés y Transporte GAM -->
        <div class="g-card" style="padding: 20px;">
          <h3 style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-main); margin-bottom: 12px;">
            Transporte y Enlaces GAM
          </h3>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: var(--color-text-muted);">
            <li>🚠 <strong>Cablebús L1:</strong> Cuautepec ⇄ Indios Verdes (Operando normal)</li>
            <li>🚍 <strong>Metrobús L6:</strong> El Rosario ⇄ Villa de Aragón</li>
            <li>🚍 <strong>Metrobús L7:</strong> Indios Verdes ⇄ Campo Marte</li>
            <li>🚇 <strong>Metro L3:</strong> Indios Verdes ⇄ Universidad</li>
          </ul>
        </div>

      </aside>

    </div>

  </div>

  <style>
    @media (min-width: 900px) {
      .layout-grid {
        grid-template-columns: 2fr 1fr;
      }
      .hero-grid {
        grid-template-columns: 1.2fr 1fr;
      }
    }

    .hover-title:hover {
      color: var(--color-primary);
      text-decoration: underline;
    }
  </style>

</BaseLayout>
