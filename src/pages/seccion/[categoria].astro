---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sections = [
    { slug: "colonias-y-barrios", name: "Colonias & Barrios", desc: "Reportes comunitarios, crónicas locales y vida barrial en Cuautepec, Aragón, Lindavista, San Felipe y toda la GAM." },
    { slug: "seguridad-y-denuncia", name: "Seguridad & Denuncia", desc: "Patrullajes preventivos, cuadrantes vecinales, botones de auxilio y denuncias de servicios públicos." },
    { slug: "movilidad-y-obras", name: "Movilidad & Obras", desc: "Cablebús L1, Metrobús, Metro Indios Verdes, jornadas de bacheo, agua y drenaje en la alcaldía." },
    { slug: "comunidad-y-servicios", name: "Comunidad & Servicios", desc: "Ferias de salud preventiva, mastografías, programas del bienestar, trámites y eventos culturales." },
    { slug: "gam-al-dia", name: "GAM al Día", desc: "Actualidad metropolitana, actividades institucionales y noticias de impacto en Gustavo A. Madero." },
  ];

  const allArticles = await getCollection('noticias');

  const normalize = (str: string) =>
    str.toLowerCase().replace(/&/g, 'y').replace(/\s+/g, '-').normalize("NFD").replace(/[\u0300-\u036f]/g, "");

  return sections.map(sec => {
    const filtered = allArticles
      .filter(art => normalize(art.data.category) === sec.slug)
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    return {
      params: { categoria: sec.slug },
      props: { section: sec, articles: filtered },
    };
  });
}

const { section, articles } = Astro.props;

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(d);
}
---

<BaseLayout
  title={`${section.name} — La Voz del Barrio GAM`}
  description={section.desc}
  activeSection={section.name}
>
  <div class="container">
    
    <!-- Section Header -->
    <header style="margin-bottom: 36px; padding-bottom: 20px; border-bottom: 1px solid var(--color-border);">
      <h1 style="font-size: 32px; font-weight: 800; color: var(--color-text-main); margin-bottom: 8px; letter-spacing: -0.4px;">
        {section.name}
      </h1>
      <p style="font-size: 15px; color: var(--color-text-muted); max-width: 680px;">
        {section.desc}
      </p>
    </header>

    <!-- Articles Grid -->
    {articles.length === 0 ? (
      <div style="padding: 48px; text-align: center; color: var(--color-text-muted); background: #ffffff; border-radius: var(--radius-card); border: 1px solid var(--color-border);">
        <p>No hay artículos publicados en esta sección por el momento.</p>
        <a href="/" style="display: inline-block; margin-top: 12px; color: var(--color-primary); font-weight: 700;">Volver al inicio</a>
      </div>
    ) : (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 28px;">
        {articles.map(art => (
          <article class="clean-card" style="display: flex; flex-direction: column; justify-content: space-between; background: #ffffff;">
            <div>
              <a href={`/noticias/${art.id}/`} style="display: block; overflow: hidden;">
                <img 
                  src={art.data.image} 
                  alt={art.data.title}
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null; this.src='/logo.png';"
                  style="width: 100%; height: 200px; object-fit: cover;" 
                />
              </a>

              <div style="padding: 22px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: 12px;">
                  <span style="color: var(--color-primary); font-weight: 700;">
                    {art.data.category}
                  </span>
                  {art.data.colonia && (
                    <span style="color: var(--color-text-subtle);">
                      {art.data.colonia}
                    </span>
                  )}
                </div>

                <h2 style="font-size: 18px; font-weight: 700; line-height: 1.35; color: var(--color-text-main); margin-bottom: 10px;">
                  <a href={`/noticias/${art.id}/`} style="color: inherit; text-decoration: none;">
                    {art.data.title}
                  </a>
                </h2>

                <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                  {art.data.excerpt || art.data.subtitle}
                </p>
              </div>
            </div>

            <div style="padding: 0 22px 20px 22px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--color-text-subtle); border-top: 1px solid var(--color-border); padding-top: 12px;">
              <span>{formatDate(art.data.pubDate)}</span>
              <a href={`/noticias/${art.id}/`} style="color: var(--color-primary); font-weight: 600;">
                Leer nota →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

  </div>
</BaseLayout>
