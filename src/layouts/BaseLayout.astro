---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  activeSection?: string;
}

const {
  title = "La Voz del Barrio GAM — Noticias y Comunidad",
  description = "Diario digital de proximidad comunitaria en la Alcaldía Gustavo A. Madero (GAM), CDMX. Cobertura de Cuautepec, Indios Verdes, Lindavista, Aragón y San Felipe de Jesús.",
  image = "/logo.png",
  canonicalURL = Astro.url.href,
  type = "website",
  pubDate,
  author = "Redacción La Voz del Barrio",
  activeSection = "Inicio",
} = Astro.props;

const siteTitle = title.includes("La Voz del Barrio") ? title : `${title} — La Voz del Barrio GAM`;

const sections = [
  { name: "Inicio", href: "/" },
  { name: "Colonias & Barrios", href: "/seccion/colonias-y-barrios/" },
  { name: "Seguridad & Denuncia", href: "/seccion/seguridad-y-denuncia/" },
  { name: "Movilidad & Obras", href: "/seccion/movilidad-y-obras/" },
  { name: "Comunidad & Servicios", href: "/seccion/comunidad-y-servicios/" },
];

const siteUrl = 'https://vozdelbarrio.com.mx';
const currentCanonical = canonicalURL || Astro.url.href;

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': currentCanonical.toString(),
      },
      headline: title,
      description: description,
      image: [image.startsWith('http') ? image : new URL(image, siteUrl).toString()],
      datePublished: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
      dateModified: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
      author: [
        {
          '@type': 'Person',
          name: author,
        },
      ],
      publisher: {
        '@type': 'NewsMediaOrganization',
        name: 'La Voz del Barrio GAM',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/logo.png`,
        },
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'NewsMediaOrganization',
      name: 'La Voz del Barrio GAM',
      url: siteUrl,
      logo: `${siteUrl}/logo.png`,
      description: description,
    };
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{siteTitle}</title>
  <meta name="title" content={siteTitle} />
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <meta name="theme-color" content="#771426" />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />
  <meta property="og:site_name" content="La Voz del Barrio GAM" />
  <meta property="og:locale" content="es_MX" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.url)} />

  <!-- Google Fonts: Plus Jakarta Sans moderna y limpia -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --color-primary: #771426;       /* Vino GAM */
      --color-primary-light: #fbebed;
      --color-bg-page: #fbfbfb;       /* Fondo blanco roto muy limpio */
      --color-bg-card: #ffffff;
      --color-border: #eaeaea;        /* Borde muy sutil */
      --color-text-main: #1a1a1a;
      --color-text-muted: #666666;
      --color-text-subtle: #8e8e8e;
      --radius-card: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--color-bg-page);
      color: var(--color-text-main);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .clean-card {
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      overflow: hidden;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .clean-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
      border-color: #d8d8d8;
    }
  </style>

  <!-- Search Engine & Google News Directives -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

</head>
<body>

  <!-- Minimalist Clean Header -->
  <header style="background: #ffffff; border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: 100;">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 20px;">
      
      <!-- Logo -->
      <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <img src="/logo-horizontal.png" alt="La Voz del Barrio GAM" style="height: 40px; width: auto;" onerror="this.onerror=null; this.src='/logo.png';" />
      </a>

      <!-- Clean Navigation Links -->
      <nav style="display: flex; align-items: center; gap: 24px; overflow-x: auto;">
        {sections.map(sec => {
          const isActive = (activeSection.toLowerCase() === sec.name.toLowerCase()) || (sec.name === "Inicio" && activeSection === "Portada");
          return (
            <a 
              href={sec.href}
              style={`font-size: 14px; font-weight: ${isActive ? '700' : '500'}; color: ${isActive ? 'var(--color-primary)' : 'var(--color-text-muted)'}; text-decoration: none; transition: color 0.15s ease; white-space: nowrap;`}
              onmouseover="this.style.color='var(--color-primary)';"
              onmouseout={`this.style.color='${isActive ? 'var(--color-primary)' : 'var(--color-text-muted)'}';`}
            >
              {sec.name}
            </a>
          );
        })}
      </nav>

    </div>
  </header>

  <!-- Main Content -->
  <main style="padding: 40px 0 80px 0;">
    <slot />
  </main>

  <!-- Clean Minimalist Footer -->
  <footer style="background: #ffffff; border-top: 1px solid var(--color-border); padding: 48px 0 32px 0;">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 32px;">
        <div>
          <img src="/logo-horizontal.png" alt="La Voz del Barrio GAM" style="height: 36px; width: auto; margin-bottom: 8px;" onerror="this.onerror=null; this.src='/logo.png';" />
          <p style="font-size: 13px; color: var(--color-text-muted); max-width: 440px;">
            Blog digital ciudadano y comunitario de la Alcaldía Gustavo A. Madero, Ciudad de México.
          </p>
        </div>

        <nav style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 13px; color: var(--color-text-muted);">
          {sections.map(s => (
            <a href={s.href} style="transition: color 0.15s ease;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">
              {s.name}
            </a>
          ))}
          <a href="https://central.neuronamedios.com" target="_blank" rel="noopener" style="color: var(--color-primary); font-weight: 600;">
            Sala de Redacción ↗
          </a>
        </nav>
      </div>

      <div style="border-top: 1px solid var(--color-border); padding-top: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; font-size: 12px; color: var(--color-text-subtle);">
        <div>
          © 2026 La Voz del Barrio GAM · <a href="mailto:redaccion@vozdelbarrio.com.mx" style="color: inherit;">redaccion@vozdelbarrio.com.mx</a>
        </div>
        <div style="display: flex; gap: 16px;">
          <a href="/admin">Admin</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>
